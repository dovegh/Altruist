# Altruist — local environment
#
# Copy to `.env` and fill in. Expo inlines EXPO_PUBLIC_* at BUILD time, so
# restart the dev server after changing anything here; a running bundler will
# keep serving the old values.
#
# Both values below are safe to ship in a client bundle. Row Level Security in
# Postgres is what protects the data, not the key.
#
# Find them in: Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://dvfigvailbkngmsciabz.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service_role key in this file. It bypasses Row Level Security,
# and anything named EXPO_PUBLIC_* ends up readable inside the shipped app.
